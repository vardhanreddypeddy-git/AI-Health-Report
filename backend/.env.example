CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_JWT_KEY=your_jwt_public_key_here
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# PostgreSQL Database Connection
# Example local: postgresql://postgres:postgres@localhost:5432/health_report_db
# Example Supabase/Neon/Render: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_report_db

# Google Gemini API Key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (optional; https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
